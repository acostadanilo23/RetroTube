<%- include('header') %>

    <!-- Channel Header -->
    <div
        style="display: flex; align-items: center; gap: 15px; margin-bottom: 20px; padding: 15px; border: 1px solid var(--border, #999); background: var(--bg-alt, #eee);">
        <% if (channelAvatar) { %>
            <img src="/proxy-image?url=<%= encodeURIComponent(channelAvatar) %>" alt="<%= channelName %>" width="80"
                height="80" style="border-radius: 50%; border: 2px solid var(--border, #999);">
            <% } %>
                <div>
                    <h2 style="margin: 0;">
                        <%= channelName %>
                    </h2>
                    <% if (channelSubscribers) { %>
                        <div style="margin-top: 5px; opacity: 0.8;">
                            <%= channelSubscribers %>
                        </div>
                        <% } %>
                </div>
                <div style="margin-left: auto;">
                    <% if (isSubscribed) { %>
                        <form action="/subscriptions/remove" method="POST" style="margin: 0;">
                            <input type="hidden" name="name" value="<%= channelName %>">
                            <input type="hidden" name="returnTo"
                                value="/channel?name=<%= encodeURIComponent(channelName) %>">
                            <button type="submit" style="padding: 6px 14px;">✕ Unsubscribe</button>
                        </form>
                        <% } else { %>
                            <form action="/subscriptions/add" method="POST" style="margin: 0;">
                                <input type="hidden" name="name" value="<%= channelName %>">
                                <input type="hidden" name="id" value="<%= channelId %>">
                                <input type="hidden" name="avatar" value="<%= channelAvatar || '' %>">
                                <button type="submit" style="padding: 6px 14px;">★ Subscribe</button>
                            </form>
                            <% } %>
                </div>
    </div>

    <h3>Videos <small>(Page <%= page %>)</small></h3>

    <% if (videos.length===0) { %>
        <p>No videos found for this channel.</p>
        <% } else { %>
            <div class="results">
                <% videos.forEach(video=> { %>
                    <div class="result-item">
                        <a href="/watch?v=<%= video.id %>"
                            style="text-decoration: none; color: inherit; display: flex; gap: 10px;">
                            <% if (mode !=='text' ) { %>
                                <div style="flex-shrink: 0;">
                                    <img loading="lazy" src="/proxy-image?url=<%= encodeURIComponent(video.thumbnail) %>"
                                        alt="<%= video.title %>" width="120" height="90"
                                        style="border: 1px solid #000; display: block;">
                                </div>
                                <% } %>
                                    <div>
                                        <div class="result-title">
                                            <%= video.title %>
                                        </div>
                                        <div class="result-meta">
                                            <%= video.publishedText %>
                                        </div>
                                    </div>
                        </a>
                    </div>
                    <% }) %>
            </div>

            <!-- Pagination -->
            <div style="margin: 20px 0; text-align: center;">
                <% if (page> 1) { %>
                    <a
                        href="/channel?name=<%= encodeURIComponent(channelName) %><%= channelId ? '&id=' + channelId : '' %>&page=<%= page - 1 %>">&laquo;
                        Previous</a>
                    <% } %>
                        <span style="margin: 0 15px;">Page <%= page %></span>
                        <% if (hasMore) { %>
                            <a
                                href="/channel?name=<%= encodeURIComponent(channelName) %><%= channelId ? '&id=' + channelId : '' %>&page=<%= page + 1 %>">Next
                                &raquo;</a>
                            <% } %>
            </div>
            <% } %>

                <%- include('footer') %>